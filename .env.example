# ─── Database ───────────────────────────────────
POSTGRES_USER=orbidi
POSTGRES_PASSWORD=orbidi_dev_pwd
POSTGRES_DB=orbidi

# Docker Compose: usa el nombre del servicio "db"
# Local (sin Docker): cambia a "localhost"
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────
BACKEND_PORT=8000

# Docker Compose: host = "db"  →  @db:5432
# Local (sin Docker): host = "localhost"  →  @localhost:5432
DATABASE_URL=postgresql+asyncpg://orbidi:orbidi_dev_pwd@db:5432/orbidi

# JWT propio (para sesión interna)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Uploads
# Docker Compose: /app/uploads (dentro del contenedor)
# Local (sin Docker): cualquier ruta local, e.g. /tmp/orbidi-uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# Anthropic (opcional, solo para el asistente IA)
ANTHROPIC_API_KEY=

# ─── Frontend ───────────────────────────────────
# El navegador siempre accede al backend desde el host, no desde dentro de Docker
VITE_API_URL=http://localhost:8000
