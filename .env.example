# ─── Database ───────────────────────────────────
POSTGRES_USER=orbidi
POSTGRES_PASSWORD=orbidi_dev_pwd
POSTGRES_DB=orbidi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://orbidi:orbidi_dev_pwd@db:5432/orbidi

# JWT propio (para sesión interna)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# Anthropic (bonus, días 6-7)
ANTHROPIC_API_KEY=

# ─── Frontend ───────────────────────────────────
VITE_API_URL=http://localhost:8000
